# ==============================================================================
# The Harmony Project — Backend Environment Configuration Example
# Copy this file to .env and replace with your local or production credentials.
# ==============================================================================

# Application Runtime Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Listening Port
PORT=5000

# Backend Server Base URL
BACKEND_URL=http://localhost:5000

# PostgreSQL Connection URI
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:password@localhost:5432/harmony_project

# Allowed Frontend Origins for Cross-Origin Resource Sharing (CORS)
# Supports single origin or comma-separated list of origins
FRONTEND_URL=http://localhost:5173

# Database Connection Pool Settings
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=5000

# ==============================================================================
# Authentication & Security Configuration (Phase 4)
# ==============================================================================

# JWT Signing Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d

# HttpOnly Cookie Name
COOKIE_NAME=auth_token

# ==============================================================================
# Google OAuth 2.0 Credentials (Phase 4)
# Create in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:5000/api/v1/auth/google/callback
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ==============================================================================
# Consultation Booking & Scheduling Configuration (Phase 5)
# ==============================================================================
DEFAULT_TIMEZONE=Asia/Kolkata
CANCELLATION_NOTICE_HOURS=2
RESCHEDULE_NOTICE_HOURS=2
