# ==============================================================================
# The Harmony Project — Backend Environment Configuration Example
# Copy this file to .env and replace with your local or production credentials.
# ==============================================================================

# Application Runtime Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Listening Port
PORT=5000

# PostgreSQL Connection URI
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# In Docker or local setup:
DATABASE_URL=postgresql://postgres:password@localhost:5432/harmony_project

# Allowed Frontend Origins for Cross-Origin Resource Sharing (CORS)
# Supports single origin or comma-separated list of origins
FRONTEND_URL=http://localhost:5173

# Database Connection Pool Settings
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=5000

# ==============================================================================
# Future Phases (Google OAuth & JWT - Reserved for Phase 4)
# ==============================================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
