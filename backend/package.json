{
  "name": "the-harmony-project-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for The Harmony Project - Holistic Living Sanctuary",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test:db": "node -e \"import('./config/db.js').then(m => m.testDbConnection().then(r => { console.log(r); process.exit(r.ok ? 0 : 1); }))\"",
    "migrate:up": "node database/migrate.js up",
    "migrate:down": "node database/migrate.js down",
    "seed": "node database/seed.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "pg-mem": "^3.0.4",
    "supertest": "^7.0.0"
  }
}
